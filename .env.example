# =============================================================================
# 環境変数のサンプル
#
# 使い方: このファイルを .env にコピーして、必要な項目だけ書き換える。
#         すべて任意で、未設定なら docker-compose.yml の既定値が使われる。
#
# ★ このアプリは文章生成・音声合成・レンダリングをすべてローカルで完結させる。
#    外部 AI サービスは一切使わないため、API キーは不要。
# =============================================================================

# ローカル LLM (ホスト側で動く Ollama)
# シナリオ生成・スタイル提案に使う。
LOCAL_LLM_BASE_URL=http://host.docker.internal:11434/v1
LOCAL_LLM_MODEL=qwen3:14b

# ホスト側 TTS サーバー (qwen3-tts/server.py)
QWEN3_TTS_BASE_URL=http://host.docker.internal:8100

# ホスト側レンダラー (mlx/renderer_server.py)
RENDERER_BASE_URL=http://host.docker.internal:8200

# ─── 環境ごとの上書き（#119） ─────────────────────────────
# 画面の URL（start.sh が最後に表示するだけ）。既定: http://localhost:3000
# APP_URL=https://movgen.example.com

# docker-compose の設定ファイルを重ねる。docker-compose.override.yml を置く代わりに使える
# COMPOSE_FILE=docker-compose.yml:docker-compose.traefik.example.yml

# Traefik の後ろに置くとき（docker-compose.traefik.example.yml が使う）
# APP_HOST=movgen.example.com
# TRAEFIK_NETWORK=traefik
# TRAEFIK_ENTRYPOINT=web

# ─── Linux で動かすとき（#120） ───────────────────────────
# ホスト側の TTS・レンダラーの待ち受けアドレス。既定: 127.0.0.1
# Linux では、コンテナからホストの 127.0.0.1 に届かないので、Docker のブリッジのアドレスにする
# HOST_SERVICES_BIND=172.17.0.1

# hyperframes が使う Chrome。arm64 の Linux では配布物の Chrome が無いので、
# ディストリビューションの Chromium を指定する（例: sudo apt install chromium）
# HYPERFRAMES_BROWSER_PATH=/usr/bin/chromium
