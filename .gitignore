# =============================================================================
# AI-MovGen — Git 管理対象の方針
#
# 管理するもの : アプリの構成に関わるソース・設定・テンプレート
#                （webapp/ のソース, engine/, templates/,
#                  docker-compose.yml, start.sh, stop.sh, 各 Dockerfile）
# 管理しないもの: 実行時に生成される成果物・ユーザーデータ・依存物・ローカル環境
#                （projects/ の出力動画, data/ の DB やログ, node_modules,
#                  仮想環境, 収録済み音声, キャッシュ, docs/ の開発ドキュメント）
# =============================================================================

# -----------------------------------------------------------------------------
# 生成された動画プロジェクト（成果物・ユーザーデータ）
#   projects/<プロジェクト名>/videos/<id>/ 以下に
#   フレーム画像(jpg)・音声(wav)・完成動画(mp4)・composition(html/css/js) が出力される。
#   取り込んだ PPTX などの入力ファイルもユーザーデータなので対象外。
# -----------------------------------------------------------------------------
/projects/*
!/projects/.gitkeep

# -----------------------------------------------------------------------------
# 実行時データ（SQLite DB・ログ・PID・モデルキャッシュ）
#   DB のテーブルは起動時に init_db() が自動作成するため、リポジトリに含めない。
# -----------------------------------------------------------------------------
/data/*
!/data/.gitkeep

# -----------------------------------------------------------------------------
# 話者の参照音声
#   参照音声は声質クローンの元データであり、実在する人物の声を含みうる。
#   リポジトリには一切含めない（ディレクトリ構造だけを .gitkeep で維持する）。
#   default/reference.wav は初回セットアップ時に各自で用意する。手順は README を参照。
# -----------------------------------------------------------------------------
/engine/voice_samples/*
!/engine/voice_samples/.gitkeep

# -----------------------------------------------------------------------------
# 依存パッケージ・ビルド成果物
#   package.json / package-lock.json は管理し、node_modules は再現可能なので除外。
# -----------------------------------------------------------------------------
node_modules/
/webapp/frontend/dist/

# -----------------------------------------------------------------------------
# ホスト側サービス用の Python 仮想環境
#   （requirements.txt と server.py は管理対象）
# -----------------------------------------------------------------------------
qwen3-tts/.venv-host/
mlx/.venv-host/
.venv/
venv/

# -----------------------------------------------------------------------------
# 開発中の作業用ディレクトリ（使い捨てのテストスクリプト・ダミー音声など）
# -----------------------------------------------------------------------------
/scratch/

# -----------------------------------------------------------------------------
# 開発ドキュメント（公開しない）
#   設計メモ・改修計画・調査記録などの内部資料。外部に公開しない方針のため
#   リポジトリには含めない。ファイル自体はローカルに残す。
# -----------------------------------------------------------------------------
/docs/

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.ruff_cache/
.pytest_cache/
.mypy_cache/

# -----------------------------------------------------------------------------
# ログ・PID・一時ファイル
# -----------------------------------------------------------------------------
*.log
*.pid
*.tmp
tmp/

# -----------------------------------------------------------------------------
# 環境変数・秘密情報（API キー等）
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example

# 環境ごとの docker-compose の上書き（#119）。見本は docker-compose.traefik.example.yml
docker-compose.override.yml

# -----------------------------------------------------------------------------
# OS・エディタ
# -----------------------------------------------------------------------------
.DS_Store
._*
Thumbs.db
.idea/
*.swp
*~
.vscode/*
!.vscode/extensions.json

# -----------------------------------------------------------------------------
# Claude Code のローカル設定・導入したスキル（個人環境なので共有しない）
# -----------------------------------------------------------------------------
/.claude/

# graphify が実行のたびに作る日付付きバックアップ（一つ前の graph.json など）。
# graphify-out 自体は Antigravity と解析結果を共有するため意図してコミットしている。
# 除外するのはこのバックアップだけ。1 回あたり約 5MB あり、git 履歴と内容が
# 重複するうえ、実行のたびに新しい日付で増えていくため。
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/

# graphify が実行のたびに書く、そのマシンの Python の絶対パス（ユーザー名を含む）。
# マシンごとに違ううえ、公開すると手元の情報が出てしまうので管理しない（#118）。
graphify-out/.graphify_python
